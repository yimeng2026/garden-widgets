{
  "name": "@garden/widgets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable research widgets and static evidence snapshots for headless BloomBloomGarden.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "sync": "node scripts/sync-law-packages.mjs",
    "sync:frontier": "node scripts/sync-frontier-content.mjs",
    "sync:method-lineage": "node scripts/sync-method-lineage.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:references": "node scripts/build-reference-audit.mjs",
    "audit:fulltext": "python scripts/verify_fulltext_evidence.py",
    "verify:references": "node scripts/verify-reference-metadata.mjs && node scripts/build-reference-audit.mjs",
    "check": "npm run audit:references && npm run build && npm test",
    "qa:browser": "node scripts/browser-check.mjs",
    "export:widget": "node scripts/export-durable-widget.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "marked": "18.1.2"
  }
}
